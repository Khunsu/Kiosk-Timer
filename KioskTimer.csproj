<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = a Windows GUI app (no console window pops up) -->
    <OutputType>WinExe</OutputType>

    <!-- net8.0-windows targets .NET 8, which ships in-box with Windows
         Forms support. No external NuGet packages are required. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KioskTimer</AssemblyName>
  </PropertyGroup>

</Project>
